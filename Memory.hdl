/**
 * The complete address space of the Hack computer's memory,
 * including RAM and memory-mapped I/O.
 *
 * Address Map (15-bit address[0..14]):
 *   0x0000 - 0x3FFF (0     - 16383) : RAM16K   (address[14]=0  -> sel = 00 or 01)
 *   0x4000 - 0x5FFF (16384 - 24575) : Screen   (address[13..14]=10)
 *   0x6000          (24576)         : Keyboard (address[13..14]=11)
 *
 * Note: Uses built-in RAM16K, Screen, Keyboard (required by official
 * Memory.tst and Computer*.tst scripts for direct memory inspection and I/O).
 */

CHIP Memory {
    IN  in[16], load, address[15];
    OUT out[16];

    PARTS:
    // 1. Route the write-enable (load) signal to the exact target segment
    //    using the top two address bits address[13..14].
    //    00 -> lower 8K RAM, 01 -> upper 8K RAM, 10 -> Screen, 11 -> Keyboard (read-only)
    DMux4Way(in=load, sel=address[13..14],
             a=loadRamLow, b=loadRamHigh, c=loadScreen, d=loadKbdUnused);

    // Combine lower and upper 8K RAM load signals into a single RAM16K load bit
    Or(a=loadRamLow, b=loadRamHigh, out=loadRam);

    // 2. Instantiate the three memory-mapped hardware devices
    RAM16K(in=in, load=loadRam, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=kbdOut);

    // 3. Select the active device's output based on address[13..14]
    Mux4Way16(a=ramOut, b=ramOut, c=screenOut, d=kbdOut,
              sel=address[13..14], out=out);
}
